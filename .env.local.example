# Copy this file to .env.local and fill in the values from the Connect button in
# the Supabase dashboard.
#
# The publishable key is meant to be public and shipped in browser code. Row
# level security is what protects the data. Never put a secret / service_role
# key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
